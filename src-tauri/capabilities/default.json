{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ana pencere yetkileri: git/claude/gh çalıştırma, SQLite, dosya tarama, ayar deposu",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "store:default",
    "dialog:allow-open",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME" }, { "path": "$HOME/**" }]
    },
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "claude", "cmd": "claude", "args": true },
        { "name": "gh", "cmd": "gh", "args": true }
      ]
    }
  ]
}
